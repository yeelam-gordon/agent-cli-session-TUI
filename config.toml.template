# ─── Agent Session TUI — Configuration ───
# This file was generated from config.toml.template at release build time
# with OS-specific launcher defaults substituted in.
#
# Copy this file next to the agent-session-tui binary and edit paths for your system.

# App data directory (archived.json, embeddings_cache.json stored here)
# data_dir = '~/.local/share/agent-session-tui'
poll_interval_ms = 2000
log_max_lines = 500

# ─── Launch Configuration ───
# Each provider can configure how sessions are launched in a terminal.
#
# Option 1 — shortcut (Windows only, currently):
#   launch_method  = "wt" | "pwsh" | "cmd"
#   launch_fallback = "cmd"
#
# Option 2 — custom command (works cross-platform, takes priority):
#   launch_cmd  = "gnome-terminal"          # any program on PATH
#   launch_args = ["--working-directory={cwd}", "--", "bash", "-c", "{command}; exec bash"]
#     placeholders: {cwd} → working directory, {command} → the agent CLI command
#   launch_fallback_cmd  = "xterm"           # tried if launch_cmd fails
#   launch_fallback_args = ["-e", "sh -c 'cd {cwd} && {command}; exec sh'"]
#
# Per-OS defaults shipped in release zips:
#   Windows → launch_method = "wt"
#   Linux   → launch_cmd    = "gnome-terminal"
#   macOS   → launch_cmd    = "osascript"  (spawns Terminal.app)

# ─── Semantic Search ───
# No configuration needed. Drop the semantic_search_plugin library next to
# the TUI binary (already included in the "-semantic" release zip).

# ─── Grouping engine ───
# Picks HOW thematic groups are suggested for ungrouped sessions. Suggestions
# render as a dim "· ⟨group⟩" shadow under the session row in the Active view;
# press `y` to accept, `n` to dismiss, `e` to edit. Press `s` in the Grouped
# view to run on demand.
#
#   engine = "remote"  DEFAULT. Sends session titles and working directories to
#                      a hosted tab auto-grouping service, which returns natural
#                      names like "System Maintenance". ~2s for 30 sessions.
#                      Nothing to install or authenticate. See the note below on
#                      what is sent.
#
#   engine = "wordmatch" No network. NOT an AI model of any kind — it just compares how
#                      many words two titles share, and names each group after
#                      its most common words (e.g. "benchmark-prompt-files"), so
#                      expect to rename some. ~0.2s. Also the automatic fallback
#                      whenever the remote engine fails.
#
#   engine = "acp"     LEGACY. Spawns the CLI configured in [acp] below. Best
#                      names, but 25-45s per batch and uses your Copilot quota.
#
# [grouping]
# engine = "remote"
# language = "en-US"            # language for generated group names
# timeout_secs = 20             # remote call timeout; the service answers in ~2s
# reuse_existing_groups = false # true = offer existing group names (service rejects these erratically)
# max_group_anchors = 6         # group names offered when reuse_existing_groups = true
#
# ─── What the "remote" engine sends ───
# Sent:       session titles and working directories (as file:/// URIs), for one
#             representative per cluster of near-duplicate sessions, plus your
#             existing group NAMES so new sessions can be folded into a group
#             you already have. Sessions already in those groups are NOT sent.
# Never sent: session summaries, file contents, chat transcripts.
# On failure: silently falls back to the local engine — grouping never breaks.
#
# The grouping service is Microsoft-hosted. Its URL is published in Microsoft's
# Edge endpoint allowlist (learn.microsoft.com/deployedge/
# microsoft-edge-security-endpoints, under "Tab groups"), but only as a
# firewall entry: there is no published request/response contract, versioning
# guarantee, or terms covering third-party callers. Titles and folder paths do
# leave your machine. If that is not acceptable, set engine = "wordmatch".

# ─── AI Auto-Grouping (ACP / Agent Client Protocol) ───
# Only used when `engine = "acp"` above. Lets the TUI ask an AI agent to
# suggest thematic groups for ungrouped sessions. When this section is absent
# or commented out, no `copilot` process is ever spawned.
#
# Set `auto_suggest = true` for background runs.
#
# Requirements (only relevant once you uncomment):
#   - `copilot` CLI installed on PATH and authenticated (`copilot login`)
#   - The `prompts/group-suggest.md` template (shipped next to the exe)
#
# Costs (with `--effort low`):
#   - ~30 sessions per batch, ~25-45s per batch on Copilot CLI
#   - Counts against your Copilot CLI usage quota
#
# A run that exceeds timeout_secs is TERMINATED, not just abandoned.
#
# [acp]
# command = "copilot"
# extra_args = ["--effort", "low"]
# auto_suggest = false               # set true for background mode
# timeout_secs = 180
# # prompt_template = '~/.config/agent-session-tui/group-suggest.md'

# ─── Remote boxes: view/resume ANOTHER machine's sessions (OPT-IN) ───
# Run the TUI with `--remote <box>` to stream that box's WHOLE session list
# (all agents) over a tunnel and resume any of them ON the box in a new host tab:
#
#   agent-session-tui                      → local sessions (this machine)
#   agent-session-tui --remote=<box>       → <box>'s sessions; Enter resumes there
#
# Configure it once with a [remote_defaults] TEMPLATE at the bottom of this file.
# `{box}` is replaced with the name you pass to --remote, so every box that
# shares the same layout needs ZERO extra config. Add a [remotes.<box>] section
# only to OVERRIDE the template for a specific box. See the block at EOF.
#
# The box side runs `<tui> --serve-json`, which ALWAYS reads local disk (it
# ignores remote settings) — so the host and box can share the SAME exe AND the
# SAME config.toml; only the launch differs (host: plain; box: --serve-json,
# invoked for you by --remote over the tunnel).
#
# (Legacy per-provider `remote_stream_cmd` / `remote_list_cmd` fields still work
# but --remote + [remote_defaults] is the recommended, box-agnostic way.)

# ─── Copilot CLI ───
[providers.copilot]
enabled = true
default = true
command = "copilot"
default_args = []
# default_args = ["--agent=memory-assistant"]
# default_args = ["--model", "claude-sonnet-4"]
state_dir = '~/.copilot/session-state'
resume_flag = "--resume"
# startup_dir = 'D:\'
launch_method = "{{LAUNCH_METHOD}}"
launch_fallback = "{{LAUNCH_FALLBACK}}"
{{LAUNCH_CMD_LINE}}
{{LAUNCH_ARGS_LINE}}
# wt_profile = "PowerShell"
