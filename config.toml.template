# ═══════════════════════════════════════════════════════════════════════════
# Remote boxes — used ONLY with `--remote=<box>`. Plain launch stays local.
# [remote_defaults] is a TEMPLATE shared by every box; `{box}` → the --remote
# name, `{command}` → the built resume command. A new box needs NO extra config.
# Add [remotes.<box>] only to override the template for one box.
# (Example uses the `devbox` CLI to reach an Azure Dev Box / VM over a tunnel.)
# ═══════════════════════════════════════════════════════════════════════════
# [remote_defaults]
# stream_cmd = ["devbox", "exec", "{box}", "agent-session-tui --serve-json 50 --interval 5"]
# launch_cmd = "wt"
# launch_args = ["-w", "0", "new-tab", "--title", "devbox {box}", "powershell", "-NoExit", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "& 'C:\\Users\\you\\OneDrive - Microsoft\\Documents\\.copilot\\tools\\devbox\\devbox.ps1' vsterm {box} -Cwd '{cwd}' -Exec '{command}'"]
#
# [remotes.special-box]           # override example (only if a box differs)
# stream_cmd = ["devbox", "exec", "special-box", "agent-session-tui --serve-json 30 --interval 10"]
