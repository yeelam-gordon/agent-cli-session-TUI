# ─── Agent Session TUI — Configuration ───
# This file was generated from config.toml.template at release build time
# with OS-specific launcher defaults substituted in.
#
# Copy this file next to the agent-session-tui binary and edit paths for your system.

# App data directory (archived.json, embeddings_cache.json stored here)
# data_dir = '~/.local/share/agent-session-tui'
poll_interval_ms = 2000
log_max_lines = 500

# ─── Launch Configuration ───
# Each provider can configure how sessions are launched in a terminal.
#
# Option 1 — shortcut (Windows only, currently):
#   launch_method  = "wt" | "pwsh" | "cmd"
#   launch_fallback = "cmd"
#
# Option 2 — custom command (works cross-platform, takes priority):
#   launch_cmd  = "gnome-terminal"          # any program on PATH
#   launch_args = ["--working-directory={cwd}", "--", "bash", "-c", "{command}; exec bash"]
#     placeholders: {cwd} → working directory, {command} → the agent CLI command
#   launch_fallback_cmd  = "xterm"           # tried if launch_cmd fails
#   launch_fallback_args = ["-e", "sh -c 'cd {cwd} && {command}; exec sh'"]
#
# Per-OS defaults shipped in release zips:
#   Windows → launch_method = "wt"
#   Linux   → launch_cmd    = "gnome-terminal"
#   macOS   → launch_cmd    = "osascript"  (spawns Terminal.app)

# ─── Semantic Search ───
# No configuration needed. Drop the semantic_search_plugin library next to
# the TUI binary (already included in the "-semantic" release zip).

# ─── AI Auto-Grouping (ACP / Agent Client Protocol) ───
# Lets the TUI ask an AI agent to suggest thematic groups for ungrouped
# sessions. Press `s` in the Grouped view to run on demand, or set
# `auto_suggest = true` to run automatically in the background after each
# initial load. Suggestions render as a dim "· ⟨group⟩" shadow under the
# session row in the Active view; press `y` to accept, `n` to dismiss, `e`
# to edit the group name before saving.
#
# Requirements:
#   - `copilot` CLI installed on PATH and authenticated (`copilot login`)
#   - The `prompts/group-suggest.md` template (shipped next to the exe)
#
# Costs (with default `--effort low` setting):
#   - ~30 sessions per batch, ~25-45s per batch on Copilot CLI
#   - When `auto_suggest = true` the TUI chains batches until all ungrouped
#     sessions have been analyzed, ~1 minute per 30-session batch
#   - Counts against your Copilot CLI usage quota
#
# Privacy:
#   - Only session titles, summaries, and updated_at timestamps are sent.
#   - Full file contents and chat transcripts are NEVER included.
[acp]
# CLI command to invoke for the AI run. Almost always "copilot".
command = "copilot"

# Extra args passed to the CLI. `--effort low` is the right level for
# structured-JSON pattern matching like grouping; saves ~30% time vs
# default with no observable quality drop. Use `["--effort", "medium"]`
# if you want richer reasoning at higher cost.
extra_args = ["--effort", "low"]

# OFF by default. Set to true to have the TUI automatically run AI
# grouping in the background after the initial session load completes
# and chain batches until all ungrouped sessions are processed.
auto_suggest = false

# Timeout for a single ACP run. With --effort low + 30 sessions, a typical
# run finishes in 25-45s. Bump higher if your model is consistently slow,
# drop lower to detect hangs faster.
timeout_secs = 180

# Path to the prompt template. If unset, the TUI looks for
# `<exe-dir>/prompts/group-suggest.md` (shipped in the release zip).
# prompt_template = '~/.config/agent-session-tui/group-suggest.md'

# ─── Copilot CLI ───
[providers.copilot]
enabled = true
default = true
command = "copilot"
default_args = []
# default_args = ["--agent=memory-assistant"]
# default_args = ["--model", "claude-sonnet-4"]
state_dir = '~/.copilot/session-state'
resume_flag = "--resume"
# startup_dir = 'D:\'
launch_method = "{{LAUNCH_METHOD}}"
launch_fallback = "{{LAUNCH_FALLBACK}}"
{{LAUNCH_CMD_LINE}}
{{LAUNCH_ARGS_LINE}}
# wt_profile = "PowerShell"

